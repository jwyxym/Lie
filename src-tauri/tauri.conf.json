{
  "productName": "lie",
  "version": "0.1.0",
  "identifier": "cn.jwyxym.lie",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lie",
        "width": 360,
        "height": 640
      }
    ],
    "security": {
      "csp": {
        "img-src": "'self' asset: http: https: blob: data:",
        "script-src": "'self' 'wasm-unsafe-eval'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
